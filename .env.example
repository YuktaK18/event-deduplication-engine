# Copy this file to ".env.local" for local development (it is ignored by git).
# On Netlify, add the same variable under Site configuration > Environment variables instead.
#
# Use the "ApiBaseUrl" value printed by "sam deploy" - no trailing slash.
VITE_API_BASE_URL=https://abc123.execute-api.ap-south-1.amazonaws.com/prod

# To try the frontend against the in-memory local server (npm run local), use:
# VITE_API_BASE_URL=http://localhost:3001
